{
  "api": {
    "port": 2039,
    "healthCheckTimeout": 3000,
    "processCleanupTimeout": 2000,
    "healthCheckEndpoints": ["/health", "/api/health", "/", "/status"],
    "minSize": 1000000,
    "maxRetries": 3
  },
  "database": {
    "url": "mongodb://127.0.0.1:27017/pointify-win",
    "sourceUrl": "mongodb://127.0.0.1:27017/postaging",  
    "sourceApiUrl": "https://api.pointifypos.com",                        
    "sourceApiToken": "",                                                  
    "readyDelay": 5000,
    "seedingMaxRetries": 15,
    "seedingRetryDelay": 2000,
    "sampleCount": 3,
    "dataSource": "pointify_api_bundle",
    "systemCollection": "system",
    "seedCollections": ["shopcategories"],
    "dataPaths": {
      "packaged": [
        "app.asar.unpacked/electron/data",
        "electron/data"
      ],
      "development": [
        "data",
        "../electron/data"
      ]
    },
    "indexes": [
      {
        "name": "shopcategories",
        "indexes": [{ "name": 1 }, { "isActive": 1 }, { "sortOrder": 1 }]
      }
    ]
  },
  "security": {
    "jwtSecret": "12345",
    "googleMapsApiKey": "AIzaSyAhhiH3PrL9td9IGJWfpK3CXnU3gtsIYHY"
  },
  "environment": {
    "nodeEnv": "production"
  },
  "server": {
    "port": 9001,
    "host": "localhost",
    "dumpsDir": "dumps",
    "online_api": "https://staging.pointifypos.com",
    "offline_api": "http://localhost:2040",
    "api_mode": "hybrid",
    "healthCheckTimeout": 8000,
    "healthTimeout": 5000,
    "successMessages": [
      "Pointify server running on http://localhost:9001",
      "Server started successfully",
      "listening on port 9001",
      "Express server listening"
    ],
    "nodePaths": [
      "/usr/local/bin/node",
      "/opt/homebrew/bin/node",
      "/usr/bin/node",
      "/usr/local/nvm/versions/node/*/bin/node"
    ],
    "env": {
      "REACT_APP_API_URL": "http://localhost:2039",
      "REACT_APP_ENVIRONMENT": "production",
      "DISABLE_ESLINT_PLUGIN": "true",
      "VITE_GOOGLE_MAPS_API_KEY": "AIzaSyAhhiH3PrL9td9IGJWfpK3CXnU3gtsIYHY"
    }
  },
  "app": {
    "name": "Pointify Desktop POS",
    "version": "1.0.3",
    "updateCheckInterval": 3600000,
    "successDisplayTime": 2000,
    "author": "Fredrick Mundia Githumbi",
    "description": "Pointify Point of Sale System",
    "website": "https://pointifypos.com"
  },
  "ui": {
    "mainWindow": {
      "width": 1400,
      "height": 900,
      "minWidth": 1200,
      "minHeight": 700
    },
    "progressWindow": {
      "width": 500,
      "height": 300
    },
    "theme": {
      "primaryColor": "#667eea",
      "secondaryColor": "#764ba2",
      "backgroundColor": "#f5f5f5"
    }
  },
  "updates": {
    "autoCheck": true,
    "checkUrl": "https://api.pointifypos.com/sync/checkupdate/desktop",
    "downloadUrl": "https://pointifypos.com/installers/",
    "timeout": 10000,
    "downloadTimeout": 300000,
    "checkInterval": 21600000,
    "startupDelay": 30000,
    "reminderDelay": 86400000,
    "betaChannel": false,
    "allowPrerelease": false
  },
  "mongodb": {
    "port": 27017,
    "host": "127.0.0.1",
    "bindIp": "127.0.0.1",
    "startupTimeout": 15000,
    "enableLogging": false,
    "logLevel": "error",
    "storageEngine": "wiredTiger",
    "dataDirectory": "data"
  },
  "downloads": {
    "maxRetries": 3,
    "retryDelay": 2000,
    "chunkSize": 8192,
    "verifyChecksum": true,
    "fallbackUrls": {
      "mongodb": [
        "https://fastdl.mongodb.org/",
        "https://downloads.mongodb.org/"
      ],
      "api": [
        "https://pointifypos.com/installers/",
        "https://backup.pointifypos.com/installers/"
      ]
    }
  },
  "logging": {
    "level": "info",
    "enableFileLogging": true,
    "maxLogFiles": 7,
    "maxLogSize": "10MB",
    "logDirectory": "logs",
    "categories": {
      "database": true,
      "api": true,
      "server": true,
      "updates": true,
      "downloads": true
    }
  },
  "performance": {
    "enableGpuAcceleration": true,
    "enableHardwareAcceleration": true,
    "memoryLimit": "2GB",
    "maxConcurrentDownloads": 2,
    "diskCacheSize": "100MB"
  },
  "features": {
    "autoBackup": true,
    "offlineMode": true,
    "syncOnStartup": false,
    "enableAnalytics": false,
    "enableCrashReporting": false,
    "enableDevTools": false
  },
  "paths": {
    "data": "data",
    "logs": "logs",
    "backups": "backups",
    "temp": "temp",
    "runtime": "runtime",
    "plugins": "plugins"
  },
  "network": {
    "userAgent": "Pointify-Desktop/1.0.0",
    "timeout": 30000,
    "retries": 3,
    "proxy": {
      "enabled": false,
      "host": "",
      "port": 0,
      "username": "",
      "password": ""
    }
  },
  "defaults": {
    "jwtSecret": "12345",
    "googleMapsApiKey": ""
  }
