# .env - Configuration for exporting data from your online Pointify API
# Create this file in your project root

# ==============================================
# POINTIFY API CONFIGURATION (for data export)
# ==============================================

# Your online Pointify API base URL
POINTIFY_API_URL=https://your-pointify-api.com

# API authentication key/token
POINTIFY_API_KEY=your-api-key-here

# Export method: 'api' (via HTTP) or 'mongodb' (direct database)
EXPORT_METHOD=mongodb

# ==============================================
# MONGODB CONFIGURATION (if using direct export)
# ==============================================

# Direct MongoDB connection to your online Pointify database
POINTIFY_MONGO_URL=mongodb://your-mongo-server:27017/pointify

# Or for MongoDB Atlas:
# POINTIFY_MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/pointify

# ==============================================
# BUILD CONFIGURATION
# ==============================================

# Environment for builds
NODE_ENV=production

# ==============================================
# EXAMPLE CONFIGURATIONS
# ==============================================

# For local testing:
# POINTIFY_API_URL=http://localhost:3000
# POINTIFY_API_KEY=test-key-123

# For production API:
# POINTIFY_API_URL=https://api.pointify.com
# POINTIFY_API_KEY=prod-key-xyz-123

# For MongoDB Atlas:
EXPORT_METHOD=mongodb
POINTIFY_MONGO_URL=mongodb://127.0.0.1:27017/pointify

# ==============================================
# NOTES
# ==============================================
# 
# 1. This file is used ONLY during build time to export data
# 2. The exported data is bundled with the app for offline use
# 3. Client computers don't need internet - they use the bundled data
# 4. Update these settings to point to YOUR online Pointify API
# 5. Make sure this file is in .gitignore for security