# Pointify POS — Server Environment Configuration
# Copy this file to .env in the same folder as start-server.bat and fill in your values.

# ------------------------------------------------------------------
# REQUIRED
# ------------------------------------------------------------------

# Secret used to sign session cookies. Use any long random string.
# Generate one at: https://www.random.org/strings/
SESSION_SECRET=change-me-to-a-long-random-string

# ------------------------------------------------------------------
# OPTIONAL (defaults shown)
# ------------------------------------------------------------------

# Port the server listens on. All other tills browse to http://<this-machine-ip>:<PORT>
PORT=3000

# Pointify cloud API base URL (online mode)
POINTIFY_API_URL=https://api.pointifypos.com

# Pointify API used when falling back to offline/local mode.
# Set this to a local Pointify API if you have one, otherwise leave it matching POINTIFY_API_URL.
POINTIFY_OFFLINE_API_URL=https://api.pointifypos.com

# Set to "production" for the live server till
NODE_ENV=production
