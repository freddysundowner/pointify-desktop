modules = ["nodejs-20", "web", "python-3.11"]
[agent]
expertMode = true
stack = "FULLSTACK_JS"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd server && PORT=3000 npm run dev"
waitForPort = 3000

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd client && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 1999
externalPort = 3001

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3002

[[ports]]
localPort = 5002
externalPort = 3003

[[ports]]
localPort = 23636
externalPort = 4200

[deployment]
deploymentTarget = "autoscale"
run = ["node", "server/dist/index.cjs"]
build = ["bash", "-c", "npm run clean && npm run build"]

[userenv]

[userenv.shared]
POINTIFY_API_URL = "https://api.pointifypos.com"
PORT = "1999"
DEV = "false"
NODE_ENV = "development"
POINTIFY_OFFLINE_API_URL = "https://staging.pointifypos.com"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
